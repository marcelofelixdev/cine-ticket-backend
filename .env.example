# Copie para .env e ajuste. O .env NUNCA vai para o git.
#   cp .env.example .env

# Perfil: dev | prod | dev,demo | prod,demo
PROFILE=dev

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# RabbitMQ
RABBITMQ_USER=cineticket
RABBITMQ_PASS=troque-esta-senha

# JWT: no mínimo 32 caracteres (gere com: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# TMDB (pôster e sinopse dos filmes). Chave gratuita em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Origens do frontend (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Admin criado no boot (em dev o padrão é marcelo@admin.com / admin12345678)
# ADMIN_EMAIL=admin@cineticket.dev
# ADMIN_PASSWORD=uma-senha-com-12-ou-mais-caracteres
# ADMIN_BOOTSTRAP_ENABLED=true   # obrigatório para criar o admin no perfil prod

# Opcionais (ADMIN_BOOTSTRAP_ENABLED, PAYMENTS_ENABLED e os de cookie são lidos direto pela aplicação, ex.: no deploy)
# API_PORT=8080
# API_DOCS_ENABLED=true
# PAYMENTS_ENABLED=false
# DEMO_VISITOR_EMAIL=visitante@cineticket.dev
# DEMO_VISITOR_PASSWORD=visitante123456
# REFRESH_COOKIE_SAME_SITE=None
